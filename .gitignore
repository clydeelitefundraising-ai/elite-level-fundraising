# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is safe to commit (no real secrets)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local link state (project ref/pooler URL, no secrets, but
# machine-local — not repo content)
supabase/.temp

# local iOS archive/export validation evidence (xcarchive, ipa, export logs —
# machine-local, not repo content)
/build_output_validation

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
