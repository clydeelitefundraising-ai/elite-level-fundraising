# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon key — currently unused in code; keep for future client-side use
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Auth PEPPERs ──────────────────────────────────────────────────────────────
# Mixed into password hashes. Choose strong random values and NEVER change them
# after first coach account is created — existing hashes will break.
TEAM_COACH_PEPPER=change-me-to-a-long-random-string
TEAM_MEMBER_PEPPER=change-me-to-a-third-long-random-string
ADMIN_PEPPER=change-me-to-a-different-long-random-string

# ── Admin ─────────────────────────────────────────────────────────────────────
# Plaintext admin password — hashed with ADMIN_PEPPER at verify time
ADMIN_PASSWORD=change-me

# ── Stripe ────────────────────────────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from Stripe Dashboard → Webhooks → your endpoint → Signing secret
# Required for POST /api/webhooks/stripe to verify events are genuinely from Stripe.
# In development, use the Stripe CLI: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# The CLI prints a whsec_... secret — use that value locally.
STRIPE_WEBHOOK_SECRET=whsec_...

# Not yet wired up — add if client-side Stripe Elements are needed
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Transactional Email (Resend) ──────────────────────────────────────────────
# Sign up at https://resend.com → create an API key → verify a sender domain
# FROM_EMAIL must match a verified sender or domain in your Resend account
RESEND_API_KEY=re_...
FROM_EMAIL=ELF Fundraising <noreply@yourdomain.com>

# Public base URL — used to build campaign links inside emails
# Local: http://localhost:3000  Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate once with: node -e "const wp=require('web-push');console.log(wp.generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose to the browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your@email.com

# ── Unified Account Auth ──────────────────────────────────────────────────────
# Mixed into elf_accounts password hashes. Choose a strong random value and
# NEVER change it after the first account is created — existing hashes will break.
ELF_ACCOUNT_PEPPER=change-me-to-a-long-random-string

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
# Create a free database at https://console.upstash.com → New Database → REST API tab
# Copy the REST URL and token exactly as shown — do not use the redis:// connection string.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
