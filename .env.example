# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon key — currently unused in code; keep for future client-side use
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Auth PEPPERs ──────────────────────────────────────────────────────────────
# Mixed into password hashes. Choose strong random values and NEVER change them
# after first coach account is created — existing hashes will break.
TEAM_COACH_PEPPER=change-me-to-a-long-random-string
TEAM_MEMBER_PEPPER=change-me-to-a-third-long-random-string
ADMIN_PEPPER=change-me-to-a-different-long-random-string

# Server-only. Mixed into calendar subscription tokens (HMAC-SHA256 of
# the subscription row's id) — never sent to the client, never logged,
# never stored. If unset, calendar sync fails closed (throws) rather than
# generating unstable/regeneratable-on-restart URLs. Never change after
# the first subscription is issued — existing subscription URLs will stop
# validating (same tradeoff as the other PEPPERs above).
CALENDAR_SYNC_PEPPER=change-me-to-a-long-random-string

# ── Admin ─────────────────────────────────────────────────────────────────────
# Plaintext admin password — hashed with ADMIN_PEPPER at verify time
ADMIN_PASSWORD=change-me

# ── Stripe ────────────────────────────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from Stripe Dashboard → Webhooks → your endpoint → Signing secret
# Required for POST /api/webhooks/stripe to verify events are genuinely from Stripe.
# In development, use the Stripe CLI: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# The CLI prints a whsec_... secret — use that value locally.
STRIPE_WEBHOOK_SECRET=whsec_...

# Not yet wired up — add if client-side Stripe Elements are needed
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Transactional Email (Resend) ──────────────────────────────────────────────
# Sign up at https://resend.com → create an API key → verify a sender domain
# FROM_EMAIL must match a verified sender or domain in your Resend account
RESEND_API_KEY=re_...
FROM_EMAIL=ELF Fundraising <noreply@yourdomain.com>

# Public base URL — used to build campaign links inside emails
# Local: http://localhost:3000  Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Marketing site's own public base URL — used for canonical/OG tags,
# robots.txt, and sitemap.xml on the marketing site build. Falls back to
# https://www.elitelevelfundraising.com if unset, so this is only needed
# to point a non-production marketing deployment somewhere else.
# NEXT_PUBLIC_MARKETING_URL=https://www.yourdomain.com

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate once with: node -e "const wp=require('web-push');console.log(wp.generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose to the browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your@email.com

# ── Native Push (APNs — Phase 10) ─────────────────────────────────────────────
# Server-side support for the native iOS app's push notifications (the iOS
# client itself is a separate, currently-unmerged branch). All four of
# APNS_KEY_ID/APNS_TEAM_ID/APNS_BUNDLE_ID/APNS_PRIVATE_KEY must be set
# together — src/lib/apns.ts checks all four before attempting to send, and
# degrades to a silent no-op (never throws) if any is missing. Generate a
# key at https://developer.apple.com/account → Certificates, IDs & Profiles
# → Keys → create an APNs key.
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_BUNDLE_ID=com.yourcompany.yourapp
# Paste the full .p8 key contents; keep the \n line-break escapes literal
# (the code unescapes them at runtime) if setting this via a single-line
# environment variable (e.g. in the Vercel dashboard).
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# "production" targets Apple's production APNs gateway; anything else
# (including unset) uses the sandbox/development gateway.
APNS_ENVIRONMENT=development

# ── Unified Account Auth ──────────────────────────────────────────────────────
# Mixed into elf_accounts password hashes. Choose a strong random value and
# NEVER change it after the first account is created — existing hashes will break.
ELF_ACCOUNT_PEPPER=change-me-to-a-long-random-string

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
# Create a free database at https://console.upstash.com → New Database → REST API tab
# Copy the REST URL and token exactly as shown — do not use the redis:// connection string.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Marketing site: demo requests ──────────────────────────────────────────────
# Inbox that receives instant notification when someone submits the public
# "Book a Demo" form. Confirmation emails to the prospect always send from
# FROM_EMAIL above; this only controls where the internal notification goes.
DEMO_NOTIFICATION_EMAIL=you@yourdomain.com

# ── Automation job scheduling ─────────────────────────────────────────────────
# Shared secret for POST /api/jobs/automation (scheduled/cron execution of the
# automation rule engine). Not wired to Vercel cron yet — this just protects
# the endpoint for when a scheduler is added. Choose a long random value.
# Pass it as `Authorization: Bearer <CRON_SECRET>` or `?secret=<CRON_SECRET>`.
CRON_SECRET=change-me-to-a-long-random-string

# ── Executive Dashboard revenue estimate ──────────────────────────────────────
# No real ELF take-rate/fee schedule exists in the schema yet. Optional
# override for the Executive Dashboard's "Estimated ELF Revenue" figure
# (Total Raised × rate). Defaults to 0.08 (8%) if unset — see
# src/app/admin/executive/page.tsx and src/lib/platform/reports.ts.
# ELF_PLATFORM_FEE_RATE=0.08
