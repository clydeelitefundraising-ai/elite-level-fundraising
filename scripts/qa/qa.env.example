# ELF QA connection settings — copy to %USERPROFILE%\.elf-qa\qa.env (OUTSIDE
# every repository; the guard refuses a file inside one) and fill in the
# QA project's values from the Supabase dashboard (project mzsvbxosoidwhntpjdkf).
# Never put production values here: the production project is refused
# wherever it appears.
ELF_QA_MODE=qa
QA_PROJECT_REF=mzsvbxosoidwhntpjdkf
QA_SUPABASE_URL=https://mzsvbxosoidwhntpjdkf.supabase.co
# Settings -> API keys (service_role / anon, or the new secret / publishable keys)
QA_SERVICE_ROLE_KEY=
QA_ANON_KEY=
# Connect -> Direct connection (port 5432), or the Session pooler in us-east-2
# (user postgres.mzsvbxosoidwhntpjdkf, port 5432). Not the transaction pooler (6543).
QA_DB_URL=postgresql://postgres:<QA database password>@db.mzsvbxosoidwhntpjdkf.supabase.co:5432/postgres
